{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "avoid",
	"printWidth": 100,
	"tabWidth": 4,
	"endOfLine": "lf",
	"quoteProps": "as-needed",
	"sortPackageJson": false,
	"ignorePatterns": [
		"node_modules/",
		"dist/",
		"build/",
		"*.log",
		".DS_Store",
		"Thumbs.db",
		"html/**/*.js",
		"html/**/*.d.ts",
		"scripts/generate-sprites.js",
		"package-lock.json"
	]
}
