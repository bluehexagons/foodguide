{
	"name": "foodguide",
	"version": "1.0.0",
	"description": "Unofficial Don't Starve food guide and recipe calculator",
	"main": "html/foodguide-data.js",
	"module": "html/foodguide-data.js",
	"type": "module",
	"sideEffects": [
		"./html/foodguide.js",
		"./html/locales/*.js",
		"./html/recipes.js",
		"./html/utils.js"
	],
	"files": [
		"html/constants.js",
		"html/food.js",
		"html/recipes.js",
		"html/functions.js",
		"html/utils.js",
		"html/mode-utils.js",
		"html/strings.js",
		"html/locales/",
		"html/foodguide-data.js",
		"LICENSE",
		"docs/",
		"readme.md",
		"html/collection.js",
		"html/constants.d.ts",
		"html/food.d.ts",
		"html/recipes.d.ts",
		"html/functions.d.ts",
		"html/utils.d.ts",
		"html/mode-utils.d.ts",
		"html/strings.d.ts",
		"html/foodguide-data.d.ts",
		"html/collection.d.ts",
		"html/models.d.ts"
	],
	"exports": {
		".": {
			"types": "./html/foodguide-data.d.ts",
			"default": "./html/foodguide-data.js"
		},
		"./constants": {
			"types": "./html/constants.d.ts",
			"default": "./html/constants.js"
		},
		"./food": {
			"types": "./html/food.d.ts",
			"default": "./html/food.js"
		},
		"./recipes": {
			"types": "./html/recipes.d.ts",
			"default": "./html/recipes.js"
		},
		"./functions": {
			"types": "./html/functions.d.ts",
			"default": "./html/functions.js"
		},
		"./utils": {
			"types": "./html/utils.d.ts",
			"default": "./html/utils.js"
		},
		"./mode-utils": {
			"types": "./html/mode-utils.d.ts",
			"default": "./html/mode-utils.js"
		},
		"./strings": {
			"types": "./html/strings.d.ts",
			"default": "./html/strings.js"
		},
		"./locales": {
			"types": "./html/locales/index.d.ts",
			"default": "./html/locales/index.js"
		},
		"./locales/*": {
			"types": "./html/locales/*.d.ts",
			"default": "./html/locales/*.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "npm run build && npm run generate-sprites && http-server html -p 8080 -o /index.htm -a 127.0.0.1 -i false -c -1 -g",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:browser",
		"fix": "npm run format && npm run lint:fix",
		"test": "npm run build && node --test",
		"test:browser": "npm run build && npm run generate-sprites && node tests/browser-smoke.js",
		"typecheck": "npm run build && tsc -p tsconfig.consumer.json && tsc -p tsconfig.consumer.json --module ES2022 --moduleResolution bundler",
		"generate-sprites": "npm run build && node scripts/generate-sprites.js",
		"build": "tsc && tsc -p tsconfig.tools.json",
		"prepare": "npm run build",
		"prepack": "npm run build",
		"build:watch": "tsc --watch"
	},
	"keywords": [
		"dont-starve",
		"food",
		"recipes",
		"game",
		"guide"
	],
	"author": "bluehexagons",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bluehexagons/foodguide.git"
	},
	"bugs": {
		"url": "https://github.com/bluehexagons/foodguide/issues"
	},
	"homepage": "https://foodguide.bluehexagons.com",
	"devDependencies": {
		"@types/node": "^20.19.43",
		"http-server": "^14.1.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"playwright": "^1.64.0",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"types": "html/foodguide-data.d.ts"
}
