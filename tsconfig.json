{
	"compilerOptions": {
		"checkJs": true,
		"allowJs": true,
		"noEmit": false,
		"strict": false,
		"module": "es2022",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"rootDir": "src",
		"outDir": "html",
		"noEmitOnError": true
	},
	"include": ["src/**/*.js"],
	"exclude": ["node_modules"]
}
