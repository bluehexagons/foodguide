{
	"compilerOptions": {
		"checkJs": false,
		"allowJs": false,
		"noEmit": false,
		"strict": true,
		"module": "es2022",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"rootDir": "src",
		"outDir": "html",
		"noEmitOnError": true,
		"declaration": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		"types": []
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
